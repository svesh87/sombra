#compdef sombra
# zsh completion for sombra. Installed as /usr/share/zsh/vendor-completions/_sombra.
#
# Verbs are listed here rather than asked of the daemon: completion runs on every
# Tab, and a Tab that waits for an answer is a Tab that stalls. Mode names are the
# exception — nothing else knows them. Asking is safe because a daemon that is not
# there is an error that comes back at once: the name simply has no owner.

_sombra_ids() {
    local field=$1
    sombra config show 2>/dev/null \
        | sed -n "s/.*\"$field\":\[\(.*\)/\1/p" \
        | grep -o '"id":"[^"]*"' | cut -d'"' -f4
}

_sombra_modes() { compadd ${(f)"$(_sombra_ids modes)"} }

_sombra() {
    local -a verbs=(
        'status:current readings and setpoints as JSON'
        'mode:select a mode'
        'set:live tuning, applied at once and not saved'
        'reset:drop live tuning'
        'mark:stamp a verdict onto the current sample'
        'fan:full speed or the mode's own curve'
        'brightness:the backlight and its automation'
        'monitor:the external monitors over DDC/CI'
        'charge:battery charge threshold'
        'config:the saved definitions'
        'reload:re-read the settings file'
        'export:read the telemetry ring'
    )

    _arguments -C \
        '--bus-address[bus the daemon answers on]:address:' \
        '--help[usage]' \
        '--version[version]' \
        '1: :->verb' \
        '*:: :->rest'

    case $state in
    verb)
        _describe 'command' verbs
        ;;
    rest)
        case $words[1] in
        mode) _sombra_modes ;;
        mark) compadd good too-loud too-slow ;;
        fan) compadd max auto ;;
        set)
            compadd -S '' pl1= pl2= max_perf_pct= turbo= epp= hwp_boost= gt_max_mhz= \
                profile= fan=
            ;;
        monitor)
            compadd list level
            ;;
        brightness)
            case $words[2] in
            "") compadd on off level base set ;;
            set) compadd -S '' response_pct= floor_pct= ceiling_pct= curve= ;;
            esac
            ;;
        config)
            case $words[2] in
            "") compadd show set save default_mode reset ;;
            set)
                case $words[3] in
                "") compadd mode brightness metrics ;;
                mode)
                    if (( CURRENT == 4 )); then
                        _sombra_modes
                    else
                        compadd -S '' label= platform_profile= pl1_w= pl2_w= max_perf_pct= \
                            turbo= epp= hwp_dynamic_boost= gt_max_mhz= fan=
                    fi
                    ;;
                brightness) compadd -S '' response_pct= floor_pct= ceiling_pct= curve= ;;
                metrics) compadd -S '' retention_days= enabled= ;;
                esac
                ;;
            save)
                case $words[3] in
                "") compadd live ;;
                *) if [[ $words[4] == to ]]; then _sombra_modes; else compadd to; fi ;;
                esac
                ;;
            reset) compadd modes brightness metrics all ;;
            default_mode) _sombra_modes ;;
            esac
            ;;
        export)
            _arguments \
                '--format[csv or json]:format:(csv json)' \
                '--from[earliest unix timestamp]:ts:' \
                '--to[latest unix timestamp]:ts:' \
                '--ring[telemetry ring]:file:_files'
            ;;
        esac
        ;;
    esac
}

_sombra "$@"
