#compdef ombra
# zsh completion for ombra. Installed as /usr/share/zsh/vendor-completions/_ombra.
#
# Verbs are listed here rather than asked of the daemon: completion runs on every
# Tab, and a Tab that opens a socket is a Tab that hangs when the daemon is not
# there. Mode names are the exception — nothing else knows them.

_ombra_ids() {
    local field=$1 socket=/run/ombra/control.sock
    [[ -S $socket ]] || return 0
    ombra --socket $socket config show 2>/dev/null \
        | sed -n "s/.*\"$field\":\[\(.*\)/\1/p" \
        | grep -o '"id":"[^"]*"' | cut -d'"' -f4
}

_ombra_modes() { compadd ${(f)"$(_ombra_ids modes)"} }

_ombra() {
    local -a verbs=(
        'status:current readings and setpoints as JSON'
        'mode:select a mode'
        'set:live tuning, applied at once and not saved'
        'reset:drop live tuning'
        'mark:stamp a verdict onto the current sample'
        'fan:full speed or the mode's own curve'
        'brightness:the backlight and its automation'
        'charge:battery charge threshold'
        'config:the saved definitions'
        'reload:re-read the settings file'
        'export:read the telemetry ring'
    )

    _arguments -C \
        '--socket[control socket]:path:_files' \
        '--help[usage]' \
        '--version[version]' \
        '1: :->verb' \
        '*:: :->rest'

    case $state in
    verb)
        _describe 'command' verbs
        ;;
    rest)
        case $words[1] in
        mode) _ombra_modes ;;
        mark) compadd good too-loud too-slow ;;
        fan) compadd max auto ;;
        set)
            compadd -S '' pl1= pl2= max_perf_pct= turbo= epp= hwp_boost= gt_max_mhz= \
                profile= fan=
            ;;
        brightness)
            case $words[2] in
            "") compadd on off level base set ;;
            set) compadd -S '' response_pct= floor_pct= curve= ;;
            esac
            ;;
        config)
            case $words[2] in
            "") compadd show set save default_mode reset ;;
            set)
                case $words[3] in
                "") compadd mode brightness ;;
                mode)
                    if (( CURRENT == 4 )); then
                        _ombra_modes
                    else
                        compadd -S '' label= platform_profile= pl1_w= pl2_w= max_perf_pct= \
                            turbo= epp= hwp_dynamic_boost= gt_max_mhz= fan=
                    fi
                    ;;
                brightness) compadd -S '' response_pct= floor_pct= curve= ;;
                esac
                ;;
            save)
                case $words[3] in
                "") compadd live ;;
                *) if [[ $words[4] == to ]]; then _ombra_modes; else compadd to; fi ;;
                esac
                ;;
            reset) compadd modes brightness all ;;
            default_mode) _ombra_modes ;;
            esac
            ;;
        export)
            _arguments \
                '--format[csv or json]:format:(csv json)' \
                '--from[earliest unix timestamp]:ts:' \
                '--to[latest unix timestamp]:ts:' \
                '--ring[telemetry ring]:file:_files'
            ;;
        esac
        ;;
    esac
}

_ombra "$@"
