# bash completion for sombra. Installed as /usr/share/bash-completion/completions/sombra.
#
# The verbs are listed here rather than asked of the daemon: completion runs on
# every Tab, and a Tab that opens a socket is a Tab that hangs when the daemon
# is not there. Mode names are the exception — they are the maintainer's own
# words, nothing else knows them, and they are only offered where one is
# expected.
_sombra_names() {
    local field=$1
    local socket=/run/sombra/control.sock
    [ -S "$socket" ] || return 0
    sombra --socket "$socket" config show 2>/dev/null \
        | sed -n "s/.*\"$field\":\[\(.*\)/\1/p" \
        | grep -o '"id":"[^"]*"' | cut -d'"' -f4
}

_sombra() {
    local cur prev words cword
    _init_completion || return

    local verbs="status mode set reset mark fan brightness charge config reload export"
    local i verb=""
    for ((i = 1; i < cword; i++)); do
        case ${words[i]} in
        --socket) ((i++)) ;;
        -*) ;;
        *)
            verb=${words[i]}
            break
            ;;
        esac
    done

    if [[ $prev == --socket ]]; then
        _filedir
        return
    fi
    if [[ $cur == -* ]]; then
        COMPREPLY=($(compgen -W "--socket --help --version" -- "$cur"))
        return
    fi
    if [[ -z $verb ]]; then
        COMPREPLY=($(compgen -W "$verbs" -- "$cur"))
        return
    fi

    case $verb in
    mode)
        COMPREPLY=($(compgen -W "$(_sombra_names modes)" -- "$cur"))
        ;;
    set)
        COMPREPLY=($(compgen -W "pl1= pl2= max_perf_pct= turbo= epp= hwp_boost= gt_max_mhz= \
            profile= fan=" -- "$cur"))
        compopt -o nospace 2>/dev/null
        ;;
    mark)
        COMPREPLY=($(compgen -W "good too-loud too-slow" -- "$cur"))
        ;;
    fan)
        COMPREPLY=($(compgen -W "max auto" -- "$cur"))
        ;;
    brightness)
        case ${words[cword - 1]} in
        brightness)
            COMPREPLY=($(compgen -W "on off level base set" -- "$cur"))
            ;;
        level | base) ;;
        *)
            COMPREPLY=($(compgen -W "response_pct= floor_pct= ceiling_pct= curve=" -- "$cur"))
            compopt -o nospace 2>/dev/null
            ;;
        esac
        ;;
    config)
        case ${words[cword - 1]} in
        config)
            COMPREPLY=($(compgen -W "show set save default_mode reset" -- "$cur"))
            ;;
        set)
            COMPREPLY=($(compgen -W "mode brightness" -- "$cur"))
            ;;
        save)
            COMPREPLY=($(compgen -W "live" -- "$cur"))
            ;;
        live)
            COMPREPLY=($(compgen -W "to" -- "$cur"))
            ;;
        reset)
            COMPREPLY=($(compgen -W "modes brightness all" -- "$cur"))
            ;;
        default_mode | to)
            COMPREPLY=($(compgen -W "$(_sombra_names modes)" -- "$cur"))
            ;;
        mode)
            COMPREPLY=($(compgen -W "$(_sombra_names modes)" -- "$cur"))
            ;;
        *)
            COMPREPLY=($(compgen -W "label= platform_profile= pl1_w= pl2_w= max_perf_pct= \
                turbo= epp= hwp_dynamic_boost= gt_max_mhz= fan= response_pct= floor_pct= ceiling_pct= \
                curve=" -- "$cur"))
            compopt -o nospace 2>/dev/null
            ;;
        esac
        ;;
    export)
        COMPREPLY=($(compgen -W "--format --from --to --ring --help" -- "$cur"))
        ;;
    esac
}

complete -F _sombra sombra
