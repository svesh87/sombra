#!/bin/sh
# The removal of the old /etc/ombra/modes.conf conffile has to be announced in
# preinst, postinst and postrm alike — dpkg looks for all three, and a conffile
# removed from only one of them comes back on a failed upgrade.
#
# Why it goes: the daemon carries its defaults compiled in and writes its own
# settings under /var/lib/ombra. A file in /etc that nothing reads is worse
# than no file at all, because it looks like configuration that has stopped
# working.
set -e

dpkg-maintscript-helper rm_conffile /etc/ombra/modes.conf 0.1.0 ombra -- "$@"

#DEBHELPER#

exit 0
