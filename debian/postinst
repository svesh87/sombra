#!/bin/sh
# Installing the package must not take over the machine's thermal controls.
#
# Handing ownership to this daemon means masking the vendor daemon, and that is
# a deliberate act with a rollback procedure, not a side effect of `dpkg -i`.
# So this script prints the commands that hand over ownership and stops there.
# dh_installsystemd is called with --no-enable --no-start for the same reason.
#
# Nothing is prepared for the console: it reaches the daemon over the system bus,
# and who may drive it is decided by the polkit action this package installs. The
# person at this screen is allowed without being asked and without joining
# anything.
set -e

#DEBHELPER#

if [ "$1" = configure ]; then
    cat <<'INSTRUCTIONS'
sombra is installed but not running. There can be exactly one owner of
the thermal controls, so handing them over is a deliberate step:

  sudo systemctl disable --now com.system76.PowerDaemon.service
  sudo systemctl mask com.system76.PowerDaemon.service
  sudo systemctl enable --now sombrad

(That is the vendor unit's real name; system76-power.service is only an alias
of it, and masking the alias leaves the real unit enabled.)

To hand the controls back:

  sudo systemctl disable --now sombrad
  sudo systemctl unmask com.system76.PowerDaemon.service
INSTRUCTIONS
fi

exit 0
