#!/bin/sh
# Recorded telemetry is data. A plain removal leaves it alone; only an explicit
# purge deletes it, because a week of samples is the material the modes are
# tuned from and discarding it on `apt remove` would be a loss nobody asked
# for.
set -e

case "$1" in
purge)
    rm -rf /var/lib/ombra
    # The group is ours and grants nothing but access to the daemon's socket.
    if getent group ombra >/dev/null 2>&1; then
        delgroup --system ombra >/dev/null 2>&1 || true
    fi
    ;;
esac

# Announced here as well as in preinst and postinst: dpkg looks for all three,
# and a conffile removed from only some of them comes back on a failed upgrade.
dpkg-maintscript-helper rm_conffile /etc/ombra/modes.conf 0.1.0 ombra -- "$@"

#DEBHELPER#

exit 0
