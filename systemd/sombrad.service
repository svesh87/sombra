[Unit]
Description=Sombra thermal, power and backlight daemon
Documentation=https://github.com/svesh87/sombra
# This daemon is the sole owner of the thermal control surface. Running it
# alongside the vendor daemon produces race-dependent behaviour rather than
# redundancy, so the vendor daemon is masked rather than ordered against.
#
# The name here is the vendor unit's real one. `system76-power.service` is only
# an Alias= of it, and naming an alias is a trap: masking the alias replaces
# the symlink that makes it resolve, after which a Conflicts= on that name
# silently matches nothing.
Conflicts=com.system76.PowerDaemon.service
After=multi-user.target

[Service]
Type=simple
ExecStart=/usr/bin/sombrad
Restart=always
RestartSec=2

# The daemon restores automatic fan control on every exit path it controls.
# This covers the one it does not: a crash. Without it a dead daemon can leave
# the fan at full speed, and nothing else will pick up after it.
ExecStopPost=/bin/sh -c 'for f in /sys/devices/platform/asus-nb-wmi/hwmon/hwmon*/pwm1_enable; do [ -w "$f" ] && echo 2 > "$f"; done; exit 0'

# The settings file, the saved state and the telemetry ring. Nothing of this
# daemon lives in /run: the control surface is a name on the system bus, and who
# may use it is decided by polkit rather than by the mode of a file.
StateDirectory=sombra
StateDirectoryMode=0755

[Install]
WantedBy=multi-user.target
